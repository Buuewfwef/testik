generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  created
  paid
  delivering
  delivered
  payment_failed
  out_of_stock
  delivery_failed
}

model Product {
  sku       String   @id
  name      String
  type      String
  price     Int
  currency  String   @default("RUB")
  image     String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  stock     SkuStock?
  keys      InventoryKey[]
  orders    Order[]

  @@index([isActive, type, price], map: "idx_products_storefront")
  @@map("products")
}

model SkuStock {
  sku       String   @id
  available Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")
  product   Product  @relation(fields: [sku], references: [sku])

  @@map("sku_stock")
}

model InventoryKey {
  id        String    @id @default(cuid())
  sku       String
  code      String    @unique
  status    String    @default("available")
  orderId   String?   @map("order_id")
  supplier  String?
  issuedAt  DateTime? @map("issued_at")
  product   Product   @relation(fields: [sku], references: [sku])

  @@index([sku, status], map: "idx_keys_sku_status")
  @@map("inventory_keys")
}

model Order {
  id          String      @id
  sku         String
  amount      Int
  currency    String
  status      OrderStatus @default(created)
  code        String?
  supplier    String?
  paidAt      DateTime?   @map("paid_at")
  deliveredAt DateTime?   @map("delivered_at")
  lastError   String?     @map("last_error")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  product     Product     @relation(fields: [sku], references: [sku])
  deliveries  Delivery[]
  ledger      LedgerEntry[]
  jobs        Job[]

  @@index([status, updatedAt], map: "idx_orders_status_updated")
  @@map("orders")
}

model PaymentEvent {
  eventId    String   @id @map("event_id")
  orderId    String   @map("order_id")
  status     String
  amount     Int
  currency   String
  payload    Json
  occurredAt DateTime @map("occurred_at")
  receivedAt DateTime @default(now()) @map("received_at")

  @@index([orderId], map: "idx_payment_events_order")
  @@map("payment_events")
}

model Delivery {
  id        String   @id @default(cuid())
  orderId   String   @unique @map("order_id")
  requestId String   @unique @map("request_id")
  supplier  String
  code      String
  createdAt DateTime @default(now()) @map("created_at")
  order     Order    @relation(fields: [orderId], references: [id])

  @@map("deliveries")
}

model LedgerEntry {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  account   String
  direction String
  amount    Int
  currency  String
  reason    String
  createdAt DateTime @default(now()) @map("created_at")
  order     Order    @relation(fields: [orderId], references: [id])

  @@unique([orderId, reason, account, direction], map: "ledger_idempotency")
  @@index([account], map: "idx_ledger_account")
  @@map("ledger_entries")
}

model Job {
  id        String   @id @default(cuid())
  type      String
  orderId   String?  @map("order_id")
  status    String   @default("pending")
  attempts  Int      @default(0)
  runAt     DateTime @default(now()) @map("run_at")
  lastError String?  @map("last_error")
  createdAt DateTime @default(now()) @map("created_at")
  order     Order?   @relation(fields: [orderId], references: [id])

  @@index([status, runAt], map: "idx_jobs_poll")
  @@map("jobs")
}

model SupplierIssue {
  requestId String   @id @map("request_id")
  supplier  String
  sku       String
  orderId   String   @map("order_id")
  code      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId], map: "idx_supplier_issues_order")
  @@map("supplier_issues")
}
